# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains secrets.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Project URL
SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"

# Publishable / anon key (safe to expose on the client)
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Service role key — NEVER expose this on the client or commit it
# Used server-side in client.server.ts to bypass RLS for admin operations
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Project ID (used by Supabase CLI)
SUPABASE_PROJECT_ID="<your-project-ref>"
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"

# ── Vercel deployment ─────────────────────────────────────────────────────────
# Set these in Vercel Dashboard → Project → Settings → Environment Variables
# All of the above SUPABASE_* vars must be added there too.
# NITRO_PRESET is auto-detected on Vercel but you can also set it explicitly:
# NITRO_PRESET=vercel
